---
import Layout from "../layouts/Layout.astro";
---

<Layout>

<!-- HERO FULLSCREEN -->
<section class="relative min-h-screen flex items-center justify-center">
  
  <img
    src="https://images.unsplash.com/photo-1526045478516-99145907023c"
    class="absolute inset-0 w-full h-full object-cover brightness-75"
  />

  <div class="relative text-center text-white max-w-2xl px-6">
    <h1 class="text-6xl md:text-7xl font-serif leading-tight">
      Fiorista xxx
    </h1>

    <p class="mt-6 text-lg opacity-90">
      Composizioni floreali sartoriali per eventi esclusivi, matrimoni e boutique private.
    </p>

    <div class="mt-8">
      <a
        href="#contact"
        class="btn btn-lg btn-primary"
      >
        Prenota una consulenza
      </a>
    </div>
  </div>
</section>

<!-- ABOUT (editoriale) -->
<section class="py-24 px-6 max-w-5xl mx-auto text-center">
  <h2 class="text-4xl font-serif mb-6">
    L’arte floreale, reinterpretata
  </h2>

  <p class="text-lg opacity-80 leading-relaxed">
    Ogni composizione nasce da un processo sartoriale.  
    Selezioniamo fiori rari e stagionali per creare atmosfere uniche e irripetibili.
  </p>
</section>

<!-- GALLERY MINIMAL LUXURY -->
<section class="px-6 pb-24">
  <div class="grid md:grid-cols-3 gap-6">

    <img class="rounded-none object-cover h-[400px] w-full"
      src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6"
    />

    <img class="rounded-none object-cover h-[400px] w-full"
      src="https://images.unsplash.com/photo-1468327768560-75b778cbb551"
    />

    <img class="rounded-none object-cover h-[400px] w-full"
      src="https://images.unsplash.com/photo-1519378058457-4c29a0a2efac"
    />

  </div>
</section>

<!-- WEDDINGS -->
<section class="bg-base-200 py-24 px-6">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-4xl font-serif mb-6">Matrimoni esclusivi</h2>

    <p class="text-lg opacity-80 mb-8">
      Disegniamo scenografie floreali su misura per location di lusso, ville e boutique wedding.
    </p>

    <a class="btn btn-outline btn-lg">
      Richiedi portfolio
    </a>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" class="py-24 text-center px-6">
  <h2 class="text-4xl font-serif mb-6">Contatto diretto</h2>

  <p class="opacity-80 mb-8">
    Scrivici per richieste private o consulenze su appuntamento.
  </p>

  <a
    href="https://wa.me/39XXXXXXXXXX"
    class="btn btn-success btn-lg"
    target="_blank"
  >
    WhatsApp
  </a>
</section>

<!-- FOOTER MINIMAL -->
<footer class="py-12 text-center opacity-60">
  Fiorista xxxxx © 2026
</footer>

</Layout>