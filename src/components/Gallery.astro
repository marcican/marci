<section id="gallery" class="py-20 px-6">
  <h2 class="text-3xl font-bold text-center mb-10">La nostra Gallery</h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {[
      "https://images.unsplash.com/photo-1501004318641-b39e6451bec6",
      "https://images.unsplash.com/photo-1468327768560-75b778cbb551",
      "https://images.unsplash.com/photo-1504198453319-5ce911bafcde",
      "https://images.unsplash.com/photo-1502780402662-acc0191717d8",
      "https://images.unsplash.com/photo-1466692476868-aef1dfb1e735",
      "https://images.unsplash.com/photo-1470509037663-253afd7f0f51"
    ].map((img) => (
      <div class="rounded-xl overflow-hidden shadow-lg">
        <img src={img} class="h-72 w-full object-cover hover:scale-105 transition" />
      </div>
    ))}
  </div>
</section>